# Your final HTTPS origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://wellspring-watershed.com
# Create an API key with permission to send email from your verified domain.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend. This is a proposed sender identity.
CONTACT_FROM_EMAIL=Wellspring & Watershed <website@wellspring-watershed.com>
CONTACT_TO_EMAIL=contact@wellspring-watershed.com
# Generate with: openssl rand -hex 32
# Same secret across all running instances; never expose as NEXT_PUBLIC_.
CONTACT_FORM_SECRET=
